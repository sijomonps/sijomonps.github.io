# Supabase Configuration
# The Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# The Supabase Publishable / Anon API Key (safe to be used in client-side code)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Public identifier for the single authorized finance account
NEXT_PUBLIC_FINANCE_LOGIN_EMAIL="finance@example.com"


